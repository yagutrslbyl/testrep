@model Eat.ViewModels.StoryVMs.CreateChapterVM


@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>First Chapter Published! • Wattpad Clone</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(180deg, #fffaf5 0%, #ffffff 100%);
            color: #222;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .container {
            max-width: 700px;
            padding: 2rem;
        }

        .icon {
            font-size: 9rem;
            margin-bottom: 1.5rem;
            color: #ff6200;
            animation: bounce 2s infinite;
        }

        @@keyframes bounce {
            0%, 20%, 50%, 80%, 100%

        {
            transform: translateY(0);
        }

        40% {
            transform: translateY(-30px);
        }

        60% {
            transform: translateY(-15px);
        }

        }

        h1 {
            font-size: 3.5rem;
            color: #ff6200;
            margin-bottom: 1rem;
            line-height: 1.1;
            font-weight: 800;
        }

        h2 {
            font-size: 2.2rem;
            color: #e55a00;
            margin-bottom: 2rem;
        }

        p {
            font-size: 1.3rem;
            color: #444;
            margin-bottom: 2.5rem;
            line-height: 1.7;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.8rem;
            background: #ff6200;
            color: white;
            font-size: 1.3rem;
            font-weight: 600;
            padding: 1rem 2.5rem;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.3s;
            box-shadow: 0 6px 20px rgba(255, 98, 0, 0.35);
        }

            .back-btn:hover {
                background: #e55a00;
                transform: translateY(-4px);
                box-shadow: 0 10px 30px rgba(255, 98, 0, 0.45);
            }

            .back-btn:active {
                transform: translateY(-1px);
            }

        .arrow {
            font-size: 1.5rem;
        }

        footer {
            margin-top: 5rem;
            color: #888;
            font-size: 0.95rem;
        }

        @@media (max-width: 600px) {
            .icon

        {
            font-size: 7rem;
        }

        h1 {
            font-size: 2.8rem;
        }

        h2 {
            font-size: 1.9rem;
        }

        p {
            font-size: 1.15rem;
        }

        }
    </style>
</head>
<body>

    <div class="container">

        <div class="icon">🎉</div>

        <h1>Published First Chapter!</h1>
        <h2>Congratulations!</h2>

        <p>
            Your first chapter is now live!<br>
            Your story has officially joined the Wattpad world.<br><br>
            Get ready for readers to discover your work — keep the inspiration flowing! ✦
        </p>

        @* <a asp-controller="Story" asp-action="StoryDetails" asp-route-id="@Model.StoryId" class="back-btn"> <span class="arrow">←</span> Go Back </a> *@
    </div>

    <footer>
        May your first chapter excitement last forever!
    </footer>

</body>
</html>